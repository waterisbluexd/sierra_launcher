import { Theme } from "theme.slint";
export { Theme }

component WallpaperCarousel inherits Rectangle {
    in property <image> current-image;
    in property <image> prev-image;
    in property <image> next-image;
    in property <image> prev-prev-image;
    in property <image> next-next-image;
    callback select-prev();
    callback select-next();
    in-out property <bool> selection-mode: false;
    in property <bool> can-select-prev: true;
    in property <bool> can-select-next: true;

    property <length> center-w: root.selection-mode ? root.width * 0.34 : root.width;
    property <length> center-h: root.selection-mode ? root.height * 0.86 : root.height;
    property <length> side-w: root.selection-mode ? root.width * 0.18 : 0px;
    property <length> side-h: root.selection-mode ? root.height * 0.64 : 0px;
    property <length> pitch: root.side-w / 2 + root.center-w / 2 + 6px;

    property <length> drag-x: 0px;
    property <bool> is-dragging: false;
    property <bool> was-dragging: false;
    property <bool> committing: false;
    property <int> commit-dir: 0; // -1 prev, 1 next

    // continuous position: -1 = prev slot fully centered, 0 = current centered, +1 = next fully centered
    property <float> d: root.pitch > 0px ? -(root.drag-x / root.pitch) : 0.0;

    function slot-w(dist: float) -> length {
        return root.side-w + (root.center-w - root.side-w) * max(0.0, 1.0 - min(abs(dist), 1.0));
    }
    function slot-h(dist: float) -> length {
        return root.side-h + (root.center-h - root.side-h) * max(0.0, 1.0 - min(abs(dist), 1.0));
    }
    function slot-x(dist: float) -> length {
        return (root.width - root.slot-w(dist)) / 2 + dist * root.pitch;
    }
    function slot-opacity(dist: float) -> float {
        return root.selection-mode ? max(0.15, 1.0 - min(abs(dist), 1.0) * 0.5) : 0.0;
    }

    clip: true;
    background: transparent;

    Image {
        source: root.prev-prev-image;
        image-fit: cover;
        width: root.slot-w(-2.0 - root.d);
        height: root.slot-h(-2.0 - root.d);
        x: root.slot-x(-2.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(-2.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
    }

    Image {
        source: root.prev-image;
        image-fit: cover;
        width: root.slot-w(-1.0 - root.d);
        height: root.slot-h(-1.0 - root.d);
        x: root.slot-x(-1.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(-1.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
    }

    center-frame := Rectangle {
        width: root.slot-w(0.0 - root.d);
        height: root.slot-h(0.0 - root.d);
        x: root.slot-x(0.0 - root.d);
        y: (root.height - self.height) / 2;
        clip: true;
        Image {
            source: root.current-image;
            image-fit: cover;
            width: 100%;
            height: 100%;
        }

        background: transparent;
        border-width: 2px;
        border-color: Theme.color4.with-alpha(root.selection-mode ? 0.5 : 0.0);
        animate x, width, height, border-color {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
    }

    Image {
        source: root.next-image;
        image-fit: cover;
        width: root.slot-w(1.0 - root.d);
        height: root.slot-h(1.0 - root.d);
        x: root.slot-x(1.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(1.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
    }

    Image {
        source: root.next-next-image;
        image-fit: cover;
        width: root.slot-w(2.0 - root.d);
        height: root.slot-h(2.0 - root.d);
        x: root.slot-x(2.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(2.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
    }

    commit-timer := Timer {
        interval: 350ms;
        running: root.committing;
        triggered => {
            root.committing = false;
            if root.commit-dir == -1 {
                root.select-prev();
            } else if root.commit-dir == 1 {
                root.select-next();
            }
            root.commit-dir = 0;
            root.is-dragging = true;
            root.drag-x = 0px;
        }
    }

    gesture-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.selection-mode && !root.committing;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.is-dragging = false;
                root.was-dragging = false;
            }
            if event.kind == PointerEventKind.up {
                if root.is-dragging {
                    root.was-dragging = true;
                    let threshold = root.pitch * 0.3;
                    if root.drag-x > threshold && root.can-select-prev {
                        root.is-dragging = false;
                        root.drag-x = root.pitch;   // finish the reveal, don't snap back
                        root.committing = true;
                        root.commit-dir = -1;
                    } else if root.drag-x < -threshold && root.can-select-next {
                        root.is-dragging = false;
                        root.drag-x = -root.pitch;
                        root.committing = true;
                        root.commit-dir = 1;
                    } else {
                        root.drag-x = 0px; // didn't cross threshold, cancel
                    }
                } else if !root.was-dragging {
                    root.selection-mode = false;
                    root.drag-x = 0px;
                }
                root.is-dragging = false;
            }
        }

        moved => {
            if self.pressed {
                let delta = self.mouse-x - self.pressed-x;
                if delta > 0px && !root.can-select-prev {
                    root.drag-x = delta * 0.25;
                } else if delta < 0px && !root.can-select-next {
                    root.drag-x = delta * 0.25;
                } else {
                    root.drag-x = delta;
                }
                if !root.is-dragging && (root.drag-x > 4px || root.drag-x < -4px) {
                    root.is-dragging = true;
                }
            }
        }
    }

    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.selection-mode;
        double-clicked => {
            root.selection-mode = true;
            root.drag-x = 0px;
        }
    }
}

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;
    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;
    in property <image> wallpaper-prev-image;
    in property <image> wallpaper-next-image;
    in property <image> wallpaper-prev-prev-image;
    in property <image> wallpaper-next-next-image;
    in property <bool> can-select-prev: true;
    in property <bool> can-select-next: true;
    callback request_hide();
    callback request_select_prev();
    callback request_select_next();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }
        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);
            HorizontalLayout {
                padding: 1px;
                spacing: 0px;
                Rectangle {
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with_alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 220px;
                        border-width: 2px;
                        border-color: Theme.color4.with_alpha(0.7);
                        clip: true;

                        carousel := WallpaperCarousel {
                            width: 100%;
                            height: 100%;
                            current-image: root.wallpaper-image;
                            prev-image: root.wallpaper-prev-image;
                            next-image: root.wallpaper-next-image;
                            prev-prev-image: root.wallpaper-prev-prev-image;
                            next-next-image: root.wallpaper-next-next-image;
                            can-select-prev: root.can-select-prev;
                            can-select-next: root.can-select-next;
                            select-prev => {
                                root.request_select_prev();
                            }
                            select-next => {
                                root.request_select_next();
                            }
                        }

                        // The blurred background hiding behind the tape roll
                        Image {
                            source: root.wallpaper-image-blurred;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            // Fades out perfectly when entering selection mode
                            opacity: carousel.selection-mode ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        Rectangle {
                            background: white.with_alpha(0.06);
                            opacity: carousel.selection-mode ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
