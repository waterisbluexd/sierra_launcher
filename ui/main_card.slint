import { Theme } from "theme.slint";
export { Theme }

component WallpaperCarousel inherits Rectangle {
    in property <image> current-image;
    in property <image> prev-image;
    in property <image> next-image;
    in property <image> prev-prev-image;
    in property <image> next-next-image;
    callback select-prev();
    callback select-next();

    in-out property <bool> selection-mode: false;

    // Tape dimensions (Fixed from float/length and parent errors)
    property <length> center-w: root.selection-mode ? root.width * 0.78 : root.width;
    property <length> center-h: root.selection-mode ? root.height * 0.86 : root.height;
    property <length> side-w: root.selection-mode ? root.width * 0.18 : 0px;
    property <length> side-h: root.selection-mode ? root.height * 0.64 : 0px;
    property <length> gap: root.selection-mode ? 10px : 0px;

    // Physics (Changed from float to length to match mouse coordinates)
    property <length> drag-x: 0px;
    property <bool> is-dragging: false;
    property <bool> was-dragging: false;

    clip: true;
    background: transparent;

    // The Film Roll Track
    track := HorizontalLayout {
        spacing: root.gap;
        // Center the track and apply drag offset
        x: (root.width - self.width) / 2 + root.drag-x;
        y: (root.height - root.center-h) / 2;

        animate x {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: ease-out;
        }
        animate spacing, y {
            duration: 350ms;
            easing: ease-out;
        }

        // Frame -2 (Far Left)
        Image {
            source: root.prev-prev-image;
            image-fit: cover;
            width: root.side-w;
            height: root.side-h;
            y: (root.center-h - self.height) / 2;
            opacity: root.selection-mode ? 0.6 : 0;
            animate width, height, opacity {
                duration: 350ms;
                easing: ease-out;
            }
        }

        // Frame -1 (Left)
        Image {
            source: root.prev-image;
            image-fit: cover;
            width: root.side-w;
            height: root.side-h;
            y: (root.center-h - self.height) / 2;
            opacity: root.selection-mode ? 0.85 : 0;
            animate width, height, opacity {
                duration: 350ms;
                easing: ease-out;
            }
        }

        // Frame 0 (Center) - Fixed the self.parent error
        center-frame := Rectangle {
            width: root.center-w;
            height: root.center-h;
            clip: true;

            Image {
                source: root.current-image;
                image-fit: cover;
                // Use the id of the parent rectangle directly instead of self.parent
                width: center-frame.width;
                height: center-frame.height;
            }

            background: transparent;
            border-width: 2px;
            border-color: Theme.color4.with-alpha(root.selection-mode ? 0.5 : 0.0);
            animate width, height, border-color {
                duration: 350ms;
                easing: ease-out;
            }
        }

        // Frame +1 (Right)
        Image {
            source: root.next-image;
            image-fit: cover;
            width: root.side-w;
            height: root.side-h;
            y: (root.center-h - self.height) / 2;
            opacity: root.selection-mode ? 0.85 : 0;
            animate width, height, opacity {
                duration: 350ms;
                easing: ease-out;
            }
        }

        // Frame +2 (Far Right)
        Image {
            source: root.next-next-image;
            image-fit: cover;
            width: root.side-w;
            height: root.side-h;
            y: (root.center-h - self.height) / 2;
            opacity: root.selection-mode ? 0.6 : 0;
            animate width, height, opacity {
                duration: 350ms;
                easing: ease-out;
            }
        }
    }

    gesture-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.selection-mode;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.is-dragging = false;
                root.was-dragging = false;
            }
            if event.kind == PointerEventKind.up {
                if root.is-dragging {
                    root.was-dragging = true;
                    // If dragged more than 15% of the center image width, switch
                    let threshold = root.center-w * 0.15;
                    if root.drag-x > threshold {
                        root.select-prev();
                    } else if root.drag-x < -threshold {
                        root.select-next();
                    }
                    // Snap back to center (animated because is-dragging becomes false)
                    root.drag-x = 0px;
                } else if !root.was-dragging {
                    // Tap on center: close selection mode
                    root.selection-mode = false;
                    root.drag-x = 0px;
                }
                root.is-dragging = false;
            }
        }

        moved => {
            if self.pressed {
                // drag-x is now a length, so it works perfectly with mouse-x
                root.drag-x += self.mouse-x - self.pressed-x;
                // Prevent tiny accidental drags from registering
                if !root.is-dragging && (root.drag-x > 4px || root.drag-x < -4px) {
                    root.is-dragging = true;
                }
            }
        }
    }

    // Area to catch double click to enter selection mode
    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.selection-mode;
        double-clicked => {
            root.selection-mode = true;
            root.drag-x = 0px;
        }
    }
}

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;
    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;
    in property <image> wallpaper-prev-image;
    in property <image> wallpaper-next-image;
    in property <image> wallpaper-prev-prev-image;
    in property <image> wallpaper-next-next-image;
    callback request_hide();
    callback request_select_prev();
    callback request_select_next();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }
        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);
            HorizontalLayout {
                padding: 1px;
                spacing: 0px;
                Rectangle {
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with_alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 220px;
                        border-width: 2px;
                        border-color: Theme.color4.with_alpha(0.7);
                        clip: true;

                        carousel := WallpaperCarousel {
                            width: 100%;
                            height: 100%;
                            current-image: root.wallpaper-image;
                            prev-image: root.wallpaper-prev-image;
                            next-image: root.wallpaper-next-image;
                            prev-prev-image: root.wallpaper-prev-prev-image;
                            next-next-image: root.wallpaper-next-next-image;
                            select-prev => {
                                root.request_select_prev();
                            }
                            select-next => {
                                root.request_select_next();
                            }
                        }

                        // The blurred background hiding behind the tape roll
                        Image {
                            source: root.wallpaper-image-blurred;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            // Fades out perfectly when entering selection mode
                            opacity: carousel.selection-mode ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        Rectangle {
                            background: white.with_alpha(0.06);
                            opacity: carousel.selection-mode ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
