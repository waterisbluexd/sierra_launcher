import { Theme } from "theme.slint";
export { Theme }

component WallpaperCarousel inherits Rectangle {
    in property <image> current-image;
    in property <image> prev-image;
    in property <image> next-image;
    in property <image> prev-prev-image;
    in property <image> next-next-image;
    callback select-prev();
    callback select-next();

    in-out property <bool> selection-mode: false;
    property <bool> was-dragging: false;

    property <length> center-width: root.selection-mode ? root.width * 0.60 : root.width;
    property <length> center-height: root.selection-mode ? root.height * 0.86 : root.height;
    property <length> side-width: root.selection-mode ? root.width * 0.14 : 0px;
    property <length> side-height: root.selection-mode ? root.height * 0.62 : 0px;
    property <length> gap: root.selection-mode ? 10px : 0px;

    property <length> strip-width: root.side-width * 2 + root.center-width + root.gap * 2;
    property <length> base-x: (root.width - root.strip-width) / 2;

    property <int> slide-dir: 0;
    property <length> track-offset: 0px;
    property <bool> is-dragging: false;
    property <length> drag-offset: 0px;

    clip: true;
    background: transparent;

    states [
        shift-next when root.slide-dir == 1: {
            track-offset: -(root.center-width + root.gap);
            in {
                animate track-offset { duration: 380ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
            }
            out {
                animate track-offset { duration: 0ms; }
            }
        }
        shift-prev when root.slide-dir == -1: {
            track-offset: root.center-width + root.gap;
            in {
                animate track-offset { duration: 380ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
            }
            out {
                animate track-offset { duration: 0ms; }
            }
        }
    ]

    strip := Rectangle {
        width: root.strip-width;
        height: root.selection-mode ? root.center-height : root.height;
        background: transparent;
        x: root.base-x + root.track-offset + (root.is-dragging ? root.drag-offset : 0px);
        y: (root.height - self.height) / 2;
        animate width, height, x {
            duration: root.is-dragging ? 0ms : 380ms;
            easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        prev-frame := Image {
            source: root.prev-image;
            image-fit: cover;
            width: root.side-width;
            height: root.side-height;
            x: 0px;
            y: (parent.height - self.height) / 2;
            opacity: root.selection-mode ? 1 : 0;
            animate width, height, opacity { duration: 380ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
        }

        current-frame := Image {
            source: root.current-image;
            image-fit: cover;
            width: root.center-width;
            height: root.center-height;
            x: root.side-width + root.gap;
            y: 0px;
            animate width, height, x { duration: 380ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
        }

        next-frame := Image {
            source: root.next-image;
            image-fit: cover;
            width: root.side-width;
            height: root.side-height;
            x: root.side-width + root.gap + root.center-width + root.gap;
            y: (parent.height - self.height) / 2;
            opacity: root.selection-mode ? 1 : 0;
            animate width, height, x, opacity { duration: 380ms; easing: cubic-bezier(0.25, 0.46, 0.45, 0.94); }
        }
    }

    gesture-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.selection-mode;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.is-dragging = false;
                root.drag-offset = 0px;
                root.was-dragging = false;
            }
            if event.kind == PointerEventKind.up {
                if root.is-dragging {
                    root.was-dragging = true;
                    let threshold = root.center-width * 0.15;
                    if root.drag-offset > threshold {
                        root.slide-dir = -1;
                        settle-timer.running = true;
                    } else if root.drag-offset < -threshold {
                        root.slide-dir = 1;
                        settle-timer.running = true;
                    } else {
                        root.drag-offset = 0px;
                    }
                } else if !root.was-dragging {
                    // Tap on center image: exit selection mode
                    root.selection-mode = false;
                    root.drag-offset = 0px;
                    root.track-offset = 0px;
                }
            }
        }

        moved => {
            if self.pressed {
                root.drag-offset = self.mouse-x - self.pressed-x;
                if root.drag-offset > 4px || root.drag-offset < -4px {
                    root.is-dragging = true;
                }
            }
        }
    }

    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: true;
        clicked => {
            if !root.selection-mode {
                root.selection-mode = true;
                root.drag-offset = 0px;
                root.track-offset = 0px;
            }
        }
        double-clicked => {
            root.selection-mode = !root.selection-mode;
            root.drag-offset = 0px;
            root.track-offset = 0px;
        }
    }

    settle-timer := Timer {
        interval: 420ms;
        running: false;
        triggered => {
            self.running = false;
            if root.slide-dir < 0 {
                root.select-prev();
            } else if root.slide-dir > 0 {
                root.select-next();
            }
            root.slide-dir = 0;
            root.track-offset = 0px;
        }
    }
}

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;
    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;
    in property <image> wallpaper-prev-image;
    in property <image> wallpaper-next-image;
    in property <image> wallpaper-prev-prev-image;
    in property <image> wallpaper-next-next-image;
    callback request_hide();
    callback request_select_prev();
    callback request_select_next();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }
        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);
            HorizontalLayout {
                padding: 1px;
                spacing: 0px;
                Rectangle {
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 220px;
                        border-width: 2px;
                        border-color: Theme.color4.with-alpha(0.7);
                        clip: true;

                        carousel := WallpaperCarousel {
                            width: 100%;
                            height: 100%;
                            current-image: root.wallpaper-image;
                            prev-image: root.wallpaper-prev-image;
                            next-image: root.wallpaper-next-image;
                            prev-prev-image: root.wallpaper-prev-prev-image;
                            next-next-image: root.wallpaper-next-next-image;
                            select-prev => {
                                root.request_select_prev();
                            }
                            select-next => {
                                root.request_select_next();
                            }
                        }

                        Image {
                            source: root.wallpaper-image-blurred;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: (hover-area.has-hover || carousel.selection-mode) ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        Rectangle {
                            background: white.with-alpha(0.06);
                            opacity: (hover-area.has-hover || carousel.selection-mode) ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        hover-area := TouchArea {
                            enabled: !carousel.selection-mode;
                            double-clicked => {
                                carousel.selection-mode = !carousel.selection-mode;
                            }
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
