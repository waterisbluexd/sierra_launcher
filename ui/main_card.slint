import { Theme } from "theme.slint";
export { Theme }

export component Island inherits Window {
    width: 486px;
    height: 714px;
    background: transparent;

    callback request_hide();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }
        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);

            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Rectangle {
                    width: 20px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                Rectangle {
                    height: 200px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                    //clock.slint here call
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
