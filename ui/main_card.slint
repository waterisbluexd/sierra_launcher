import { Theme } from "theme.slint";
export { Theme }

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;

    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;

    callback request_hide();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }

        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);

            HorizontalLayout {
                padding: 1px;
                spacing: 0px;

                Rectangle { //sierra launcher fountain
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 220px;
                        border-width: 2px;
                        border-color: Theme.color4.with-alpha(0.7);
                        clip: true;

                        Image {
                            source: root.wallpaper-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: 0.8;
                        }

                        Image {
                            source: root.wallpaper-image-blurred;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: hover-area.has-hover ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        Rectangle {
                            background: white.with-alpha(0.06);
                            opacity: hover-area.has-hover ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        hover-area := TouchArea { }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
