import { Theme } from "theme.slint";
export { Theme }

component WallpaperCarousel inherits Rectangle {
    in property <image> current-image;
    in property <image> prev-image;
    in property <image> next-image;
    callback select-prev();
    callback select-next();

    in-out property <bool> selection-mode: false;
    property <length> center-width: root.selection-mode ? root.width * 0.62 : root.width;
    property <length> center-height: root.selection-mode ? root.height * 0.88 : root.height;
    property <length> side-width: root.selection-mode ? root.width * 0.18 : 0px;
    property <length> side-height: root.selection-mode ? root.height * 0.6 : 0px;
    property <length> gap: 14px;
    property <length> move-distance: root.center-width + root.gap;
    property <int> slide-dir: 0;
    property <length> base-x: root.selection-mode ? (root.width - (root.side-width * 2 + root.center-width + root.gap * 2)) / 2 : 0px;
    property <length> track-offset: 0px;
    property <bool> is-dragging: false;
    property <length> drag-start-x: 0px;
    property <length> drag-offset: 0px;

    clip: true;
    background: transparent;

    states [
        shift-next when root.slide-dir == 1: {
            track-offset: -root.move-distance;
            in {
                animate track-offset {
                    duration: 400ms;
                    easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
                }
            }
            out {
                animate track-offset { duration: 0ms; }
            }
        }
        shift-prev when root.slide-dir == -1: {
            track-offset: root.move-distance;
            in {
                animate track-offset {
                    duration: 400ms;
                    easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
                }
            }
            out {
                animate track-offset { duration: 0ms; }
            }
        }
    ]

    center-only := Image {
        source: root.current-image;
        image-fit: cover;
        width: root.center-width;
        height: root.center-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        opacity: root.selection-mode ? 0 : 1;
        animate x, width, height, opacity, y {
            duration: 300ms;
            easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
    }

    center-only-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.selection-mode;
        clicked => {
            root.selection-mode = true;
            root.drag-offset = 0px;
            root.track-offset = 0px;
        }
        double-clicked => {
            root.selection-mode = true;
            root.drag-offset = 0px;
            root.track-offset = 0px;
        }
    }

    film-strip := Rectangle {
        width: root.side-width * 2 + root.center-width + root.gap * 2;
        height: root.center-height;
        background: transparent;
        x: root.base-x + root.track-offset + (root.is-dragging ? root.drag-offset : 0px);
        y: (root.height - self.height) / 2;
        opacity: root.selection-mode ? 1 : 0;
        animate x, opacity {
            duration: root.is-dragging ? 0ms : 400ms;
            easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        prev-frame := Image {
            source: root.prev-image;
            image-fit: cover;
            width: root.side-width;
            height: root.side-height;
            x: 0px;
            y: (self.height - self.height) / 2;
        }

        current-frame := Image {
            source: root.current-image;
            image-fit: cover;
            width: root.center-width;
            height: root.center-height;
            x: root.side-width + root.gap;
            y: 0px;
        }

        next-frame := Image {
            source: root.next-image;
            image-fit: cover;
            width: root.side-width;
            height: root.side-height;
            x: root.side-width + root.gap + root.center-width + root.gap;
            y: (self.height - self.height) / 2;
        }
    }

    interaction-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.selection-mode;

        moved => {
            if self.pressed && !root.is-dragging {
                root.is-dragging = true;
                root.drag-start-x = self.mouse-x;
            }
            if self.pressed && root.is-dragging {
                root.drag-offset = self.mouse-x - root.drag-start-x;
            }
        }

        clicked => {
            if root.is-dragging {
                root.is-dragging = false;
                let threshold = root.center-width * 0.18;
                if root.drag-offset > threshold {
                    root.slide-dir = -1;
                    root.track-offset = 0px;
                    settle-timer.running = true;
                } else if root.drag-offset < -threshold {
                    root.slide-dir = 1;
                    root.track-offset = 0px;
                    settle-timer.running = true;
                } else {
                    root.drag-offset = 0px;
                }
            }
        }
    }

    prev-touch := TouchArea {
        x: root.base-x;
        y: (root.height - root.side-height) / 2;
        width: root.side-width;
        height: root.side-height;
        enabled: root.selection-mode;
        clicked => {
            root.slide-dir = -1;
            settle-timer.running = true;
        }
    }

    next-touch := TouchArea {
        x: root.base-x + root.side-width + root.gap + root.center-width + root.gap;
        y: (root.height - root.side-height) / 2;
        width: root.side-width;
        height: root.side-height;
        enabled: root.selection-mode;
        clicked => {
            root.slide-dir = 1;
            settle-timer.running = true;
        }
    }

    center-touch := TouchArea {
        x: root.base-x + root.side-width + root.gap;
        y: (root.height - root.center-height) / 2;
        width: root.center-width;
        height: root.center-height;
        enabled: root.selection-mode;
        clicked => {
            root.selection-mode = false;
            root.drag-offset = 0px;
            root.track-offset = 0px;
        }
        double-clicked => {
            root.selection-mode = false;
            root.drag-offset = 0px;
            root.track-offset = 0px;
        }
    }

    function go-prev() {
        if !settle-timer.running {
            root.slide-dir = -1;
            settle-timer.running = true;
        }
    }

    function go-next() {
        if !settle-timer.running {
            root.slide-dir = 1;
            settle-timer.running = true;
        }
    }

    settle-timer := Timer {
        interval: 420ms;
        running: false;
        triggered => {
            self.running = false;
            if root.slide-dir < 0 {
                root.select-prev();
            } else if root.slide-dir > 0 {
                root.select-next();
            }
            root.slide-dir = 0;
            root.track-offset = 0px;
            root.drag-offset = 0px;
        }
    }
}

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;
    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;
    in property <image> wallpaper-prev-image;
    in property <image> wallpaper-next-image;
    callback request_hide();
    callback request_select_prev();
    callback request_select_next();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }
        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);
            HorizontalLayout {
                padding: 1px;
                spacing: 0px;
                Rectangle {
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 220px;
                        border-width: 2px;
                        border-color: Theme.color4.with-alpha(0.7);
                        clip: true;

                        carousel := WallpaperCarousel {
                            width: 100%;
                            height: 100%;
                            current-image: root.wallpaper-image;
                            prev-image: root.wallpaper-prev-image;
                            next-image: root.wallpaper-next-image;
                            select-prev => {
                                root.request_select_prev();
                            }
                            select-next => {
                                root.request_select_next();
                            }
                        }

                        Image {
                            source: root.wallpaper-image-blurred;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            opacity: (hover-area.has-hover || carousel.selection-mode) ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        Rectangle {
                            background: white.with-alpha(0.06);
                            opacity: (hover-area.has-hover || carousel.selection-mode) ? 0 : 1;
                            animate opacity {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                        }

                        hover-area := TouchArea {
                            enabled: !carousel.selection-mode;
                            double-clicked => {
                                carousel.selection-mode = !carousel.selection-mode;
                            }
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
