import { Theme } from "theme.slint";
import { Clock } from "cards/clock.slint";
export { Theme }

export component Island inherits Window {
    width: 486px;
    height: 714px;
    background: transparent;

    in property <string> clock-time: "00:00";
    in property <string> clock-date: "01 Jan, Monday";

    callback request_hide();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }

        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);

            HorizontalLayout {
                padding: 12px;
                spacing: 0px;

                Rectangle { //sierra launcher fountain
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 200px;
                        border-width: 2px;
                        border-color: Theme.color4.with-alpha(0.7);

                        Clock {
                            time: root.clock-time;
                            date: root.clock-date;
                            height: 120px;
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
