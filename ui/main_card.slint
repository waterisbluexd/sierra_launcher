import { Theme } from "theme.slint";
export { Theme }

export component Island inherits Window {
    width: 420px;
    height: 630px;
    background: transparent;

    in property <image> wallpaper-image;

    callback request_hide();
    forward-focus: scope;

    scope := FocusScope {
        key-released(event) => {
            if event.text == Key.Escape {
                root.request_hide();
            }
            accept
        }

        Rectangle {
            background: Theme.background.with-alpha(0.7);
            border-width: 2px;
            border-color: Theme.color4.with-alpha(0.7);

            HorizontalLayout {
                padding: 1px;
                spacing: 0px;

                Rectangle { //sierra launcher fountain
                    width: 0px;
                    border-width: 2px;
                    border-color: Theme.color4.with-alpha(0.7);
                }

                VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 200px;
                        border-width: 2px;
                        border-color: Theme.color4.with-alpha(0.7);
                        clip: true;
                        Image {
                            source: root.wallpaper-image;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            opacity: 0.9;
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
