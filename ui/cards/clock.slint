import { Theme } from "../theme.slint";

export component Clock inherits Rectangle {
    in property <string> greeting: "Good evening, User!";
    in property <string> time: "00:00";
    in property <string> date: "11 August, Tuesday";

    in property <length> time-font-size: 34px;
    property <float> aw: 0.8;

    VerticalLayout {
        spacing: 4px;
        alignment: start;

        // Greeting
        Text {
            text: root.greeting;
            color: Theme.foreground.with-alpha(aw);
            font-size: 13px;
            letter-spacing: 0.5px;
            font-family: "Monocraft";
            horizontal-alignment: left;
        }

        // Main clock
        Text {
            text: root.time;
            color: Theme.foreground;
            font-size: root.time-font-size;
            letter-spacing: 2px;
            font-family: "Monocraft";
            horizontal-alignment: left;
        }

        // Date
        Text {
            text: root.date;
            color: Theme.foreground.with-alpha(aw);
            font-size: 14px;
            letter-spacing: 0.5px;
            font-family: "Monocraft";
            horizontal-alignment: left;
        }
    }
}
