import { Theme } from "../theme.slint";
import { WeatherCloud } from "../weather/cloud.slint";
import { RainDrop } from "../weather/raindrop.slint";
import { MoonWithCloudPosition } from "../weather/moon_with_cloud_position.slint";
import { SunWithCloudPosiiton } from "../weather/sun_with_cloud_position.slint";

import { Sun } from "../weather/sun.slint";
import { Moon } from "../weather/moon.slint";

export component Weather inherits Rectangle {
    in property <length> icon-size: 50px;
    in property <length> pixel-size: 2px;

    in property <bool> is-rainy: false;
    in property <bool> is-cloudy: false;
    in property <bool> is-clear: true;
    in property <bool> is-day: true;

    width: root.icon-size;
    height: root.icon-size;

    clear-container := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 4px;

        width: 10 * root.pixel-size;
        height: 10 * root.pixel-size;

        visible: root.is-clear;

        if root.is-day: Sun {
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        if !root.is-day: Moon {
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }
    }

    cloudy-container := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 6px;

        width: 22 * root.pixel-size;
        height: 20 * root.pixel-size;

        visible: root.is-cloudy;

        if root.is-day: SunWithCloudPosiiton {
            x: 18 * root.pixel-size;
            y: -4 * root.pixel-size;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        if !root.is-day: MoonWithCloudPosition {
            x: 18 * root.pixel-size;
            y: -4 * root.pixel-size;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        WeatherCloud {
            x: 0px;
            y: -20px;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }
    }

    rainy-container := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 6px;

        width: 22 * root.pixel-size;
        height: 28 * root.pixel-size;

        visible: root.is-rainy;

        property <length> rain-start-y: 11 * root.pixel-size;
        property <duration> fall-period: 1s;

        property <[{x: int, delay: duration}]> drops: [
            {x: 8,  delay: 0ms},
            {x: 12, delay: 300ms},
            {x: 16, delay: 150ms},
            {x: 19, delay: 450ms},
        ];

        if root.is-day: SunWithCloudPosiiton {
            x: 18 * root.pixel-size;
            y: -4 * root.pixel-size;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        if !root.is-day: MoonWithCloudPosition {
            x: 18 * root.pixel-size;
            y: -5 * root.pixel-size;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        WeatherCloud {
            x: 0px;
            y: -22px;
            pixel-size: root.pixel-size;
            opacity: 0.9;
        }

        for d in drops: RainDrop {
            start-x: d.x;
            start-y: rain-start-y;
            fall-duration: fall-period;
            fall-distance: 6 * root.pixel-size;
            delay: d.delay;
            pixel-size: root.pixel-size;
        }
    }
}