import { Theme } from "../theme.slint";

export component WallpaperCarousel inherits Rectangle {
    in property <image> current-image;
    in property <image> prev-image;
    in property <image> next-image;
    in property <image> prev-prev-image;
    in property <image> next-next-image;
    callback select-prev();
    callback select-next();
    in-out property <bool> selection-mode: false;
    in property <bool> can-select-prev: true;
    in property <bool> can-select-next: true;

    property <length> center-w: root.selection-mode ? root.width * 0.34 : root.width;
    property <length> center-h: root.selection-mode ? root.height * 0.86 : root.height;
    property <length> side-w: root.selection-mode ? root.width * 0.18 : 0px;
    property <length> side-h: root.selection-mode ? root.height * 0.64 : 0px;
    property <length> pitch: root.side-w / 2 + root.center-w / 2 + 6px;

    property <length> drag-x: 0px;
    property <length> anchor-x: 0px;
    property <bool> is-dragging: false;
    property <bool> was-dragging: false;
    property <float> d: root.pitch > 0px ? -(root.drag-x / root.pitch) : 0.0;

    function slot-w(dist: float) -> length {
        return root.side-w + (root.center-w - root.side-w) * max(0.0, 1.0 - min(abs(dist), 1.0));
    }
    function slot-h(dist: float) -> length {
        return root.side-h + (root.center-h - root.side-h) * max(0.0, 1.0 - min(abs(dist), 1.0));
    }
    function slot-x(dist: float) -> length {
        return (root.width - root.slot-w(dist)) / 2 + dist * root.pitch;
    }
    function slot-opacity(dist: float) -> float {
        return root.selection-mode ? max(0.15, 1.0 - min(abs(dist), 1.0) * 0.5) : 0.0;
    }

    clip: true;
    background: transparent;

    Image {
        source: root.prev-prev-image;
        image-fit: cover;
        width: root.slot-w(-2.0 - root.d);
        height: root.slot-h(-2.0 - root.d);
        x: root.slot-x(-2.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(-2.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    Image {
        source: root.prev-image;
        image-fit: cover;
        width: root.slot-w(-1.0 - root.d);
        height: root.slot-h(-1.0 - root.d);
        x: root.slot-x(-1.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(-1.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    center-frame := Rectangle {
        width: root.slot-w(0.0 - root.d);
        height: root.slot-h(0.0 - root.d);
        x: root.slot-x(0.0 - root.d);
        y: (root.height - self.height) / 2;
        clip: true;
        Image {
            source: root.current-image;
            image-fit: cover;
            width: 100%;
            height: 100%;
        }

        background: transparent;
        border-width: 2px;
        border-color: Theme.color4.with-alpha(root.selection-mode ? 0.5 : 0.0);
        animate x, width, height, border-color {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    Image {
        source: root.next-image;
        image-fit: cover;
        width: root.slot-w(1.0 - root.d);
        height: root.slot-h(1.0 - root.d);
        x: root.slot-x(1.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(1.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    Image {
        source: root.next-next-image;
        image-fit: cover;
        width: root.slot-w(2.0 - root.d);
        height: root.slot-h(2.0 - root.d);
        x: root.slot-x(2.0 - root.d);
        y: (root.height - self.height) / 2;
        opacity: root.slot-opacity(2.0 - root.d);
        animate x, width, height, opacity {
            duration: root.is-dragging ? 0ms : 350ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    gesture-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.selection-mode;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.is-dragging = false;
                root.was-dragging = false;
                root.anchor-x = self.mouse-x;
            }
            if event.kind == PointerEventKind.up {
                if root.is-dragging {
                    root.was-dragging = true;
                    let threshold = root.pitch * 0.3;
                    if root.drag-x > threshold && root.can-select-prev {
                        root.select-prev();
                    } else if root.drag-x < -threshold && root.can-select-next {
                        root.select-next();
                    }
                    root.drag-x = 0px;
                } else if !root.was-dragging {
                    root.selection-mode = false;
                    root.drag-x = 0px;
                }
                root.is-dragging = false;
            }
        }

        moved => {
            if !self.pressed {
                return;
            }
            let raw = self.mouse-x - root.anchor-x;
            if raw > 0px && !root.can-select-prev {
                root.drag-x = raw * 0.25;
            } else if raw < 0px && !root.can-select-next {
                root.drag-x = raw * 0.25;
            } else {
                root.drag-x = raw;
            }
            if !root.is-dragging && (root.drag-x > 4px || root.drag-x < -4px) {
                root.is-dragging = true;
            }
            if root.drag-x >= root.pitch && root.can-select-prev {
                root.select-prev();
                root.anchor-x += root.pitch;
                root.drag-x -= root.pitch;
            } else if root.drag-x <= -root.pitch && root.can-select-next {
                root.select-next();
                root.anchor-x -= root.pitch;
                root.drag-x += root.pitch;
            }
            if root.drag-x >= root.pitch && root.can-select-prev {
                root.select-prev();
                root.anchor-x += root.pitch;
                root.drag-x -= root.pitch;
            } else if root.drag-x <= -root.pitch && root.can-select-next {
                root.select-next();
                root.anchor-x -= root.pitch;
                root.drag-x += root.pitch;
            }
        }
    }

    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.selection-mode;
        double-clicked => {
            root.selection-mode = true;
            root.drag-x = 0px;
        }
    }
}
